# Copy to .env (git ignores it), fill in, and run commands with
#   uv run --env-file .env keepout ...
# or set UV_ENV_FILE=.env once in your shell.
#
# Keep the values in single quotes: unquoted or in double quotes, uv expands
# $NAME in them, which would change a password holding a $. A password with
# a ' cannot be written here: see docs/spacetrack.md for another way.

# Space-Track.org account (free: https://www.space-track.org), for
# `keepout fetch catalog --source spacetrack` and `keepout fetch cdm`.
SPACETRACK_IDENTITY='you@example.org'
SPACETRACK_PASSWORD='your password'

# Optional: the cache root for downloaded data (default: the user cache
# directory, ~/.cache/keepout on Linux).
# KEEPOUT_CACHE_DIR='/path/to/cache'
