# The part of astropy.units keepout uses: units, their products and
# quotients, and quantities made by multiplying numbers by a unit. A
# quantity's value is a scalar or an array, as its input was: Any.
from typing import Any

import numpy.typing as npt

class UnitBase:
    def __mul__(self, other: UnitBase, /) -> UnitBase: ...
    def __truediv__(self, other: UnitBase, /) -> UnitBase: ...
    def __rmul__(self, other: npt.ArrayLike, /) -> Quantity: ...

class Quantity:
    @property
    def value(self) -> Any: ...
    def to_value(self, unit: UnitBase | str | None = None, /) -> Any: ...
    def __mul__(self, other: UnitBase | float, /) -> Quantity: ...
    def __rmul__(self, other: float, /) -> Quantity: ...
    def __truediv__(self, other: UnitBase | float, /) -> Quantity: ...
    def __neg__(self) -> Quantity: ...

m: UnitBase
km: UnitBase
s: UnitBase
hour: UnitBase
day: UnitBase
