# The part of astropy.time keepout uses. A Time holds one epoch (``isscalar``)
# or an array of them; array-valued attributes are 0-d for a single epoch.
# Values and comparisons are scalars or arrays as the Time is: Any. The
# arithmetic is typed: Time - Time is a TimeDelta, Time +- a duration a Time.
from collections.abc import Iterator
from typing import Any, Self, TypeAlias, overload

import numpy as np
import numpy.typing as npt
from astropy.units import Quantity, UnitBase

_Duration: TypeAlias = TimeDelta | Quantity

class TimeDelta:
    def to_value(self, unit: UnitBase | str, /) -> Any: ...
    @property
    def sec(self) -> Any: ...
    @property
    def jd(self) -> Any: ...
    def __neg__(self) -> TimeDelta: ...
    def __abs__(self) -> TimeDelta: ...
    @overload
    def __add__(self, other: Time, /) -> Time: ...
    @overload
    def __add__(self, other: _Duration, /) -> TimeDelta: ...
    def __radd__(self, other: Quantity, /) -> TimeDelta: ...
    def __sub__(self, other: _Duration, /) -> TimeDelta: ...
    def __mul__(self, other: npt.ArrayLike, /) -> TimeDelta: ...
    @overload
    def __truediv__(self, other: _Duration, /) -> Any: ...
    @overload
    def __truediv__(self, other: npt.ArrayLike, /) -> TimeDelta: ...
    def __lt__(self, other: _Duration, /) -> Any: ...
    def __le__(self, other: _Duration, /) -> Any: ...
    def __gt__(self, other: _Duration, /) -> Any: ...
    def __ge__(self, other: _Duration, /) -> Any: ...

class Time:
    def __init__(
        self,
        val: Any,
        val2: Any = None,
        format: str | None = None,
        scale: str | None = None,
        precision: int | None = None,
        in_subfmt: str | None = None,
        out_subfmt: str | None = None,
        location: Any = None,
        copy: bool | None = None,
    ) -> None: ...
    @classmethod
    def now(cls) -> Self: ...
    @property
    def jd1(self) -> npt.NDArray[np.float64]: ...
    @property
    def jd2(self) -> npt.NDArray[np.float64]: ...
    @property
    def jd(self) -> Any: ...
    @property
    def mjd(self) -> Any: ...
    @property
    def isot(self) -> Any: ...
    @property
    def iso(self) -> Any: ...
    @property
    def unix(self) -> Any: ...
    @property
    def datetime(self) -> Any: ...
    @property
    def year(self) -> Any: ...
    @property
    def value(self) -> Any: ...
    @property
    def utc(self) -> Self: ...
    @property
    def tai(self) -> Self: ...
    @property
    def tt(self) -> Self: ...
    @property
    def ut1(self) -> Self: ...
    @property
    def tdb(self) -> Self: ...
    @property
    def scale(self) -> str: ...
    format: str
    precision: int
    out_subfmt: str
    @property
    def isscalar(self) -> bool: ...
    @property
    def masked(self) -> bool: ...
    @property
    def shape(self) -> tuple[int, ...]: ...
    @property
    def size(self) -> int: ...
    @property
    def ndim(self) -> int: ...
    def copy(self, format: str | None = None) -> Self: ...
    def reshape(self, *shape: Any) -> Self: ...
    def ravel(self) -> Self: ...
    def strftime(self, format_spec: str) -> Any: ...
    def to_value(self, format: str, subfmt: str = "*") -> Any: ...
    def argmin(self, axis: int | None = None) -> Any: ...
    def argmax(self, axis: int | None = None) -> Any: ...
    def argsort(self, axis: int = -1) -> Any: ...
    def min(self, axis: int | None = None) -> Self: ...
    def max(self, axis: int | None = None) -> Self: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[Self]: ...
    def __getitem__(self, item: Any) -> Self: ...
    def __setitem__(self, item: Any, value: Any) -> None: ...
    def __add__(self, other: _Duration, /) -> Self: ...
    def __radd__(self, other: _Duration, /) -> Self: ...
    @overload
    def __sub__(self, other: Time, /) -> TimeDelta: ...
    @overload
    def __sub__(self, other: _Duration, /) -> Self: ...
    def __lt__(self, other: Time) -> Any: ...
    def __le__(self, other: Time) -> Any: ...
    def __gt__(self, other: Time) -> Any: ...
    def __ge__(self, other: Time) -> Any: ...
    def __eq__(self, other: object) -> Any: ...
    def __ne__(self, other: object) -> Any: ...
